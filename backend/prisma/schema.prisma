generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("DRIVER")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  driver       Driver?
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
}

model Driver {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationId          String    @unique @default(cuid())
  fullName                String
  profilePhotoUrl         String?
  dateOfBirth             DateTime?
  gender                  String?
  mobileNumber            String
  alternateMobile         String?
  registrationType        RegistrationType @default(DRIVER_ONLY)
  verificationStatus      VerificationStatus @default(SUBMITTED)
  profileCompletionPercent Int      @default(0)
  submittedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  address                 DriverAddress?
  drivingExperience       DrivingExperience?
  drivingLicence          DrivingLicence?
  emergencyContact        EmergencyContact?
  documents               DriverDocument[]
  vehicles                Vehicle[]
  consents                DriverConsent[]
  permissions             DriverPermission?
  notifications           Notification[]
}

model DriverAddress {
  id         String  @id @default(cuid())
  driverId   String  @unique
  driver     Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  doorNumber String
  street     String
  village    String
  district   String
  state      String
  pinCode    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DrivingExperience {
  id                 String   @id @default(cuid())
  driverId           String   @unique
  driver             Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  totalYears         Int
  previousCompany    String?
  employmentDuration String?
  workDescription    String?
  languages          String[]
  preferredLocation  String?
  willingLongDistance Boolean @default(false)
  drivingCategories  String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DrivingLicence {
  id               String   @id @default(cuid())
  driverId         String   @unique
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  licenceNumber    String   @unique
  licenceClass     String
  issuingAuthority String
  issueDate        DateTime
  expiryDate       DateTime
  stateOfIssue     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EmergencyContact {
  id            String   @id @default(cuid())
  driverId      String   @unique
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  contactName   String
  contactNumber String
  relationship  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DriverDocument {
  id                 String             @id @default(cuid())
  driverId           String
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documentType       DocumentType
  fileUrl            String
  fileName           String
  mimeType           String
  fileSize           Int
  verificationStatus DocumentStatus     @default(PENDING)
  expiryDate         DateTime?
  rejectionReason    String?
  uploadedAt         DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([driverId])
}

model Vehicle {
  id                 String    @id @default(cuid())
  driverId           String
  driver             Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  category           String
  manufacturer       String
  model              String
  registrationNumber String    @unique
  manufacturingYear  Int
  seatingCapacity    Int
  fuelType           String
  colour             String
  hasAC              Boolean   @default(false)
  verificationStatus DocumentStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  documents          VehicleDocument[]
  photos             VehiclePhoto[]

  @@index([driverId])
}

model VehicleDocument {
  id                 String         @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType       String
  fileUrl            String
  fileName           String
  mimeType           String
  fileSize           Int
  expiryDate         DateTime?
  verificationStatus DocumentStatus @default(PENDING)
  uploadedAt         DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([vehicleId])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  photoType String
  fileUrl   String
  fileName  String
  uploadedAt DateTime @default(now())

  @@index([vehicleId])
}

model DriverConsent {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  consentType String
  granted   Boolean
  grantedAt DateTime @default(now())

  @@unique([driverId, consentType])
}

model DriverPermission {
  id              String   @id @default(cuid())
  driverId        String   @unique
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  cameraGranted   Boolean  @default(false)
  locationGranted Boolean  @default(false)
  microphoneGranted Boolean @default(false)
  updatedAt       DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  driverId  String
  driver    Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([driverId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum RegistrationType {
  DRIVER_ONLY
  DRIVER_WITH_VEHICLE
}

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum DocumentType {
  AADHAAR_CARD
  DRIVING_LICENCE_FRONT
  DRIVING_LICENCE_BACK
  PROFILE_PHOTO
  ADDRESS_PROOF
  PAN_CARD
}

enum DocumentStatus {
  PENDING
  VERIFIED
  UNDER_REVIEW
  REJECTED
  EXPIRED
  RESUBMISSION_REQUIRED
}

enum NotificationType {
  REGISTRATION
  DOCUMENT
  APPROVAL
  REJECTION
  VEHICLE
  PROFILE
  SYSTEM
}
